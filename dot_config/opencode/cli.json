{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "session": {
    "permissions": "autoaccept"
  },
  "mouse": true,
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "diffs": {
    "view": "auto"
  },
  "cursor": {
    "style": "default"
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "plugins": ["./herdr-opencode"]
}
